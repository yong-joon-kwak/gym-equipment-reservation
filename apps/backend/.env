# 이 파일은 커밋된다. 실제 접속 정보·시크릿을 적지 않는다 — 자리표시자만 둔다.
# 기기·배포 환경의 실제 값은 .env.local 에 덮어쓴다 (git 무시).
# 네 파일의 역할과 로드 순서: docs/architecture/backend.md §6.5

APP_ENV=dev
APP_SECRET=dev-only-not-a-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# MariaDB 는 기기에 직접 설치해 띄운다 (docs/BUILD-PLAN.md §2).
# 아래는 자리표시자다. 쓰는 형태는 둘 중 하나이고, 실제 값은 .env.local 에 적는다.
#   (a) 유닉스 소켓 + OS 사용자 인증 — Homebrew 기본값
#       DATABASE_URL="mysql://<user>@localhost/gym?unix_socket=/tmp/mysql.sock&serverVersion=mariadb-12.3.2&charset=utf8mb4"
#   (b) TCP + 비밀번호
DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/gym?serverVersion=mariadb-12.3.2&charset=utf8mb4"

# 통합 테스트(T3)는 gym_test 스키마를 쓴다. .env.local 은 test 환경에서 로드되지
# 않으므로, 로컬 T3 의 접속 정보는 .env.test.local 에 넣는다 (4단계).
