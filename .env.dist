# 환경 변수 견본. 백엔드를 만든 뒤(2단계) 이 파일을 apps/backend/.env 로 복사해 값을 채운다.
#   cp .env.dist apps/backend/.env
# 복사본(apps/backend/.env)은 .gitignore 대상이다. 이 견본에는 실제 비밀값을 넣지 않는다.

APP_ENV=dev
APP_SECRET=copy-and-replace-this-in-your-local-env

# MariaDB 11.4 — 기기에 직접 설치해 띄운다 (docs/BUILD-PLAN.md §2).
#
# (a) 유닉스 소켓 + OS 사용자 인증 (Homebrew 기본값). <user>·<socket> 을 자기 값으로 바꾼다.
#     소켓 경로는 `mariadb -e "SHOW VARIABLES LIKE 'socket'"` 로 확인한다.
DATABASE_URL="mysql://<user>@localhost/gym?unix_socket=/tmp/mysql.sock&serverVersion=mariadb-11.4.0&charset=utf8mb4"
#
# (b) TCP + 비밀번호 인증을 쓰는 경우
# DATABASE_URL="mysql://<user>:<password>@127.0.0.1:3306/gym?serverVersion=mariadb-11.4.0&charset=utf8mb4"
#
# serverVersion 은 Doctrine 이 DDL 을 만들 때 쓰는 값이다. 설치된 서버 버전과 맞춘다.
# 통합 테스트(T3)는 gym_test 스키마를 쓴다 — apps/backend/.env.test 에서 덮어쓴다(4단계).
